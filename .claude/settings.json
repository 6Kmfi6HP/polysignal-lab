{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".venv"
    ],
    "sparsePaths": [
      ".claude",
      "src",
      "tests",
      "docs",
      "config",
      "scripts",
      "data"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": false
  }
}
