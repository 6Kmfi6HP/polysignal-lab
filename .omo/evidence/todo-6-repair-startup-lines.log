   665	        1. refresh_markets_once() every 5 iterations
   666	        2. evaluate_once() to run strategies and gate
   667	        3. process_accepted_signals() to store, publish, and paper-trade
   668	        4. check_settlements() to settle resolved markets
   669	        5. generate_daily_report() once per day
   670	        6. Persist state every 10 iterations
   671	        7. Sleep for refresh_interval_sec
   672	        """
   673	        self.logger.info("Starting PolySignal Lab scheduler run loop")
   674	        self._running = True
   675	
   676	        self._validate_telegram_startup()
   677	        self._initialize_trading_components()
   678	
   679	        # Restore wallet state from previous runs (if any)
   680	        await self._restore_wallet_state()
   681	
   682	        await self.refresh_markets_once()
   683	        await self._fetch_resolved_markets()
   684	
   685	        # Start WebSocket background tasks
   686	        await self.start_websockets()
